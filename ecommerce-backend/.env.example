# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Supabase) connection — this is the only DB credential the app
# actually reads (via `pg`). SUPABASE_URL/SERVICE_ROLE_KEY below are not used
# by any code here; kept only as a reference to the Supabase project, in case
# a future batch needs the Supabase client (e.g. storage) instead of raw pg.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=change-me

# Seed / reset tooling (instructor use only)
SEED_TENANTS=s1,s2,s3
SEED_STUDENT_PASSWORD=Student@123
RESET_TOKEN=change-me-too
